# Optional public link used by the unconfigured-deployment screen.
# Example: https://github.com/dastageerb/solorise
NEXT_PUBLIC_REPOSITORY_URL=

# Firebase Web SDK configuration (safe to expose to the browser).
# Firebase security comes from Auth + Firestore Rules, not from hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK configuration (server only — never prefix with NEXT_PUBLIC_).
# On Google infrastructure you may use GOOGLE_APPLICATION_CREDENTIALS instead.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Required when an admin stores an AI key from the Solorise Settings screen.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Optional alternative to configuring AI through Settings:
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
# Optional for local or custom endpoints:
AI_BASE_URL=

# Extra exact hostnames/IPs that the admin local-model detector may contact.
# Loopback (localhost, 127.0.0.1, ::1) is always allowed.
LOCAL_MODEL_ALLOWED_HOSTS=

# Optional MCP HTTP/SSE mode. Stdio (`npm run mcp`) is the safer default.
# Non-loopback MCP_HOST values require a long MCP_AUTH_TOKEN.
MCP_HOST=127.0.0.1
MCP_PORT=3333
MCP_AUTH_TOKEN=
MCP_ALLOWED_ORIGINS=

# Used by `npm run bootstrap:admin`.
SOLORISE_ADMIN_EMAIL=
SOLORISE_ADMIN_PASSWORD=
SOLORISE_ADMIN_NAME=Workspace owner
